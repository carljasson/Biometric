# ===== BLOCK /public/index.php directly =====
<Files "index.php">
    <If "%{REQUEST_URI} =~ m#^/public/index\.php$#">
        Require all denied
    </If>
</Files>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Redirect /public exactly to root
    RewriteCond %{REQUEST_URI} ^/public/?$
    RewriteRule ^public/?$ / [R=301,L]

    # Redirect any other /public/* URL to root
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ===== SECURITY BLOCKS =====
# Block hidden files like .env
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive directories
RedirectMatch 403 ^/(vendor|storage|bootstrap|config|database|resources|routes|tests)(.*)$

# Block direct access to images you want private
<FilesMatch "logo\.png">
    Require all denied
</FilesMatch>

# Optionally, block all .php files outside index.php
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} !~ m#^/index\.php$#">
        Require all denied
    </If>
</FilesMatch>
