<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to /public/index.php
    RewriteCond %{THE_REQUEST} "\s/public/index\.php"
    RewriteRule ^public/index\.php$ - [F,L]

    # Redirect any /public/* URL to root
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Redirect all other requests to the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files/folders
<FilesMatch "^(\.env|\.git|composer\.json|artisan|server\.php|storage|vendor)">
    Order allow,deny
    Deny from all
</FilesMatch>
